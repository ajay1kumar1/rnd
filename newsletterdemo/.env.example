# ----------------------------------------------------------------------------
# Example environment configuration for newsletterdemo (WAT tools / workflows)
# Copy to .env and fill in real values:  cp .env.example .env
# ----------------------------------------------------------------------------

# --- App ---
APP_ENV=development
LOG_LEVEL=info

# --- LLM / API keys ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- WAT workflow settings ---
WAT_WORKFLOW_DIR=workflows
WAT_TOOLS_DIR=tools
WAT_MAX_RETRIES=3
WAT_TIMEOUT_SECONDS=30

# --- Datastore (if used) ---
DATABASE_URL=

# --- Outbound integrations (fill in as needed) ---
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
