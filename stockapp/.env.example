# ============================================================
# Swing Trade Dashboard - Environment Configuration
# Copy this file to ".env" and adjust values as needed.
# ============================================================

# --- Database ---
DATABASE_PATH=./data/stocks.db

# --- Data Provider ---
# Primary provider is Yahoo Finance via yfinance (FREE, no API key required).
# NSE stocks are queried with a ".NS" suffix automatically (e.g. RELIANCE.NS).
DATA_PROVIDER=yfinance

# Optional fallback provider if you want to add one later (not required to run the app).
# Get a free key at https://www.alphavantage.co/support/#api-key (5 calls/min, 500/day free tier)
ALPHA_VANTAGE_API_KEY=

# --- Strategy Settings ---
RSI_PERIOD=14
RSI_BUY_THRESHOLD=40

# --- Backend API ---
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# --- Auto-refresh (in seconds) used by Streamlit dashboard ---
AUTO_REFRESH_INTERVAL_SECONDS=300

# --- RAG / Local LLM (Ollama) ---
# Install Ollama from https://ollama.com and pull a model, e.g.:
#   ollama pull llama3.2
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
# If Ollama isn't running, the RAG endpoint automatically falls back to
# plain retrieval (returns the most relevant notes without LLM generation).

# --- Embeddings model for RAG (downloaded once, runs locally, free) ---
EMBEDDING_MODEL=all-MiniLM-L6-v2
